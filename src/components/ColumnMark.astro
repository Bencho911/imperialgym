---
/**
 * Columna griega simplificada: motivo gráfico decorativo (separadores, viñetas).
 * Es un dibujo propio y genérico, NO el logo. Usar con moderación.
 */
interface Props {
  size?: string;
  class?: string;
}
const { size = '1em', class: className } = Astro.props;
---

<svg
  class:list={['column-mark', className]}
  xmlns="http://www.w3.org/2000/svg"
  style={`width: ${size}; height: ${size}`}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <rect x="3" y="2" width="18" height="3" />
  <rect x="5" y="5.5" width="14" height="1.5" />
  <rect x="6" y="7.5" width="2.5" height="10.5" />
  <rect x="10.75" y="7.5" width="2.5" height="10.5" />
  <rect x="15.5" y="7.5" width="2.5" height="10.5" />
  <rect x="5" y="18.5" width="14" height="1.5" />
  <rect x="3" y="20.5" width="18" height="2" />
</svg>
