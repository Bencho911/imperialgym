---
/*
  Logo de Imperial Gym.
  PENDIENTE: el archivo real (public/brand/logo.svg o .png) aún no existe.
  Mientras tanto se muestra un marcador de TEXTO con proporciones similares.
  No redibujar el logo: cuando llegue el archivo, reemplazar el marcador por <img>.
*/
interface Props {
  size?: 'sm' | 'md' | 'lg';
}
const { size = 'md' } = Astro.props;
---

<!-- Texto real ("IMG IMPERIAL"), así el nombre accesible coincide con lo que se ve (WCAG 2.5.3). -->
<span class:list={['logo', `logo--${size}`]} title="[LOGO PENDIENTE]">
  <span class="logo__mark">IMG</span>{' '}
  <span class="logo__word">IMPERIAL</span>
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    color: var(--color-text);
    outline: var(--border-thin) dashed var(--color-border-strong);
    outline-offset: var(--space-1);
  }
  .logo__mark {
    font-family: var(--font-display);
    letter-spacing: var(--tracking-display);
  }
  .logo__word {
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-label);
  }
  .logo--sm .logo__mark { font-size: var(--step-3); }
  .logo--sm .logo__word { font-size: var(--step--1); }
  .logo--md .logo__mark { font-size: var(--step-5); }
  .logo--md .logo__word { font-size: var(--step-0); }
  .logo--lg .logo__mark { font-size: var(--step-7); }
  .logo--lg .logo__word { font-size: var(--step-2); }
</style>
