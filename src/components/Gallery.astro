---
import SectionHeading from './SectionHeading.astro';
import Photo from './Photo.astro';
import { gallery } from '../data/gallery';
---

<section class="section" aria-labelledby="instalaciones">
  <div class="container">
    <SectionHeading id="instalaciones" title="Instalaciones" intro="Zona de pesas, máquinas y salones de clase." />
    <ul class="gallery" role="list">
      {gallery.map((item, i) => (
        <li data-reveal="photo" style={`--i: ${i % 3}`}>
          <Photo image={item.image} alt={item.alt} label={item.label} ratio="4 / 5" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }
  .gallery li {
    border-radius: var(--radius-md);
  }
  @media (min-width: 48rem) {
    .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
</style>
