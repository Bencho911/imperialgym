---
/**
 * Botón flotante de WhatsApp, visible en todo el sitio.
 * Con JS: se oculta mientras se ve la portada (que ya tiene su botón) y aparece al
 * salir de ella con una entrada rápida y un pulso, una sola vez.
 * Sin JS: siempre visible.
 */
import Icon from './Icon.astro';
import { whatsappMessages } from '../data/site';
import { whatsappUrl } from '../lib/whatsapp';
---

<a
  class="fab"
  href={whatsappUrl(whatsappMessages.general)}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escríbenos por WhatsApp (abre WhatsApp)"
  data-fab
>
  <Icon name="message-circle" size="var(--icon-lg)" />
</a>

<script is:inline>
  /* Inline: oculta el botón antes del primer pintado (si no, aparece y desaparece al cargar). */
  (function () {
    var fab = document.querySelector('[data-fab]');
    var hero = document.querySelector('#inicio');
    if (!fab || !hero || !('IntersectionObserver' in window)) return;
    fab.dataset.state = 'hidden';
    new IntersectionObserver(function (entries) {
      var show = !entries[0].isIntersecting;
      fab.dataset.state = show ? 'shown' : 'hidden';
      if (show && !fab.dataset.pulsed) fab.dataset.pulsed = 'pending';
    }).observe(hero);
    fab.addEventListener('animationend', function () {
      fab.dataset.pulsed = 'done';
    });
  })();
</script>

<style>
  .fab {
    position: fixed;
    right: var(--space-4);
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-fab);
    display: grid;
    place-items: center;
    width: var(--space-16);
    height: var(--space-16);
    border-radius: var(--radius-round);
    background: var(--color-accent);
    color: var(--color-text-on-accent);
    box-shadow: var(--shadow-raised);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      opacity var(--duration-base) var(--ease-out-strong),
      transform var(--duration-base) var(--ease-out-strong),
      visibility 0s;
  }
  .fab:hover {
    background: var(--color-accent-hover);
  }
  .fab:active {
    transform: scale(0.94);
  }
  .fab:focus-visible {
    border-radius: var(--radius-round);
  }

  /* Oculto mientras se ve la portada: no se puede enfocar ni tocar. */
  .fab[data-state='hidden'] {
    opacity: 0;
    transform: translateY(var(--space-6)) scale(0.9);
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--duration-fast) var(--ease-in),
      transform var(--duration-fast) var(--ease-in),
      visibility 0s linear var(--duration-fast);
  }

  /* Pulso único: un anillo que se expande y desaparece (transform + opacity). */
  .fab::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: var(--border-thick) solid var(--color-accent);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .fab[data-state='shown'][data-pulsed='pending']::after {
      animation: pulse-once var(--duration-entrance) var(--ease-out) var(--duration-base) 1 both;
    }
  }
  @keyframes pulse-once {
    from {
      opacity: 0.8;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fab,
    .fab[data-state='hidden'] {
      transform: none;
    }
  }

  @media (min-width: 64rem) {
    .fab {
      right: var(--space-8);
      bottom: var(--space-8);
    }
  }
</style>
