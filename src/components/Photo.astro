---
/**
 * Foto del sitio. Si hay imagen, Astro genera AVIF + WebP en varios tamaños.
 * Si no (image = null), muestra un marcador con la misma proporción y la etiqueta [FOTO: ...].
 *
 * - priority: solo para la foto de portada (es el LCP): carga inmediata y fetchpriority alto.
 * - El resto carga en diferido (loading="lazy").
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata | null;
  /** Texto alternativo descriptivo (qué se ve en la foto). */
  alt: string;
  /** Etiqueta del marcador mientras no haya foto, ej. "[FOTO: zona de pesas, sede centro]". */
  label: string;
  ratio?: string;
  /** Ancho que ocupa en pantalla, para elegir el tamaño correcto. */
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const {
  image,
  alt,
  label,
  ratio = '4 / 3',
  sizes = '(min-width: 64rem) 33vw, 50vw',
  priority = false,
  class: className,
} = Astro.props;
---

{
  image ? (
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[400, 800, 1200, 1600, 2000].filter((w) => w <= image.width)}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
      class:list={['photo', className]}
      style={`aspect-ratio: ${ratio}`}
    />
  ) : (
    <div class:list={['photo-placeholder', className]} style={`aspect-ratio: ${ratio}`} role="img" aria-label={alt}>
      <span aria-hidden="true">{label}</span>
    </div>
  )
}

<style>
  .photo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  .photo-placeholder {
    display: grid;
    place-items: center;
    padding: var(--space-4);
    background: var(--color-surface-raised);
    border: var(--border-thin) dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    text-align: center;
  }
</style>
