---
import Photo from './Photo.astro';
import { photos } from '../data/photos';
import { hours, hoursNote } from '../data/hours';
import { formatRange } from '../lib/format';
---

<!-- Caja roja sobre foto, como su pieza "Horario de atención". -->
<section class="section" aria-labelledby="horarios">
  <div class="container hours-layout">
    <div class="hours-photo">
      <Photo {...photos.hours} ratio="4 / 5" sizes="(min-width: 64rem) 58vw, 100vw" />
    </div>

    <div class="hours-card">
      <h2 id="horarios" class="hours-card__title texture-worn">Horario de atención</h2>
      <dl class="hours">
        {hours.map((row) => (
          <div class="hours__row">
            <dt class="hours__day">{row.label}</dt>
            <dd class="hours__time">{formatRange(row.opens, row.closes)}</dd>
          </div>
        ))}
      </dl>
      <p class="hours-card__note">{hoursNote}</p>
    </div>
  </div>
</section>

<style>
  .hours-layout {
    display: grid;
  }
  .hours-photo {
    display: none;
  }
  .hours-card {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-10) var(--space-6);
    background: var(--color-red-800);
    border-radius: var(--radius-md);
  }
  .hours-card__title {
    font-size: var(--step-6);
    text-align: center;
  }
  .hours {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: var(--border-thick) dashed var(--color-text);
  }
  .hours__row {
    display: grid;
    gap: var(--space-1);
    justify-items: start;
  }
  .hours__day {
    padding: var(--space-1) var(--space-3);
    background: var(--color-label-bg);
    color: var(--color-text-accent-on-light);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
  }
  .hours__time {
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
  }
  .hours-card__note {
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
    text-align: center;
    justify-self: center;
  }

  @media (min-width: 30rem) {
    .hours {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: var(--space-3) var(--space-4);
    }
    .hours__row {
      display: contents;
    }
  }

  /* Escritorio: la caja se monta sobre la foto. */
  @media (min-width: 64rem) {
    .hours-layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: center;
    }
    .hours-photo {
      display: block;
      grid-column: 1 / span 7;
      grid-row: 1;
    }
    .hours-card {
      grid-column: 6 / span 7;
      grid-row: 1;
      padding: var(--space-12) var(--space-10);
      box-shadow: var(--shadow-raised);
    }
  }
</style>
