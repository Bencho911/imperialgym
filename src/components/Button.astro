---
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  icon?: IconName;
  /** Abre en otra pestaña y avisa a lectores de pantalla con externalLabel. */
  external?: boolean;
  externalLabel?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  icon,
  external = false,
  externalLabel = '(se abre en otra pestaña)',
  class: className,
} = Astro.props;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  {icon && <Icon name={icon} />}
  <span><slot /></span>
  {external && <span class="visually-hidden">{externalLabel}</span>}
</a>

<style>
  .btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    border: var(--border-thick) solid transparent;
    border-radius: var(--radius-md);
    font-family: var(--font-body);
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    text-align: center;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-instant) var(--ease-out);
  }
  .btn--md {
    padding: var(--space-3) var(--space-6);
    font-size: var(--step-0);
  }
  .btn--sm {
    padding: var(--space-2) var(--space-4);
    font-size: var(--step--1);
  }

  /* Relleno que entra en diagonal (hover y foco). Solo se mueve con transform. */
  .btn::before {
    content: '';
    position: absolute;
    inset: 0 -25%;
    z-index: -1;
    transform: translateX(-100%) skewX(-20deg);
    transition: transform var(--duration-base) var(--ease-out-strong);
  }
  .btn:hover::before,
  .btn:focus-visible::before {
    transform: translateX(0) skewX(-20deg);
  }
  .btn:active {
    transform: scale(0.97);
  }

  .btn--primary {
    background: var(--color-accent);
    color: var(--color-text-on-accent);
  }
  .btn--primary::before {
    background: var(--color-accent-hover);
  }
  .btn--primary:active::before {
    background: var(--color-accent-pressed);
  }

  .btn--secondary {
    background: transparent;
    border-color: var(--color-text);
    color: var(--color-text);
  }
  .btn--secondary::before {
    background: var(--color-accent);
  }
  .btn--secondary:hover,
  .btn--secondary:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-text-on-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:active {
      transform: none;
    }
  }
</style>
