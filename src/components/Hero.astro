---
import Button from './Button.astro';
import Photo from './Photo.astro';
import { photos } from '../data/photos';
import { whatsappUrl } from '../lib/whatsapp';
import { site, whatsappMessages } from '../data/site';
import { locations } from '../data/locations';

const locationList = locations.map((l) => l.name).join(' y ');
const title = site.tagline;
const words = title.split(' ');
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <!-- Foto de portada: es el LCP, por eso carga con prioridad y sin animación de entrada propia. -->
  <div class="hero__media">
    {photos.hero.image ? (
      <Photo {...photos.hero} ratio="auto" sizes="100vw" priority class="hero__photo" />
    ) : (
      <div class="hero__placeholder" role="img" aria-label={photos.hero.alt}>
        <span class="hero__media-label" aria-hidden="true">{photos.hero.label}</span>
      </div>
    )}
  </div>
  <span class="hero__sweep" aria-hidden="true"></span>

  <div class="container hero__content">
    <!-- Cada palabra va en su propio recorte; el script agrupa por línea para que entren juntas. -->
    <!-- Espacios reales entre palabras: el titular se copia y se lee como texto normal. -->
    <h1 id="hero-title" class="hero__title texture-worn" data-hero-title>
      {words.map((word, i) => (
        <>
          {i > 0 && ' '}
          <span class="hero__word"><span>{word}</span></span>
        </>
      ))}
    </h1>
    <script is:inline>
      /* Corre antes del primer pintado: numera la línea visual de cada palabra para que el recorte entre por líneas. */
      (function () {
        var words = document.currentScript.previousElementSibling.querySelectorAll('.hero__word');
        var line = -1;
        var lastTop = -Infinity;
        for (var i = 0; i < words.length; i++) {
          var top = words[i].offsetTop;
          if (top > lastTop + 1) {
            line++;
            lastTop = top;
          }
          words[i].style.setProperty('--line', line);
        }
      })();
    </script>
    <p class="hero__lead">
      Gimnasio en {site.city}, {site.region}, con dos sedes: {locationList}. Pesas, máquinas y clases grupales.
    </p>
    <div class="hero__actions">
      <Button href={whatsappUrl(whatsappMessages.visit)} icon="message-circle" external externalLabel="(abre WhatsApp)">
        Escríbenos por WhatsApp
      </Button>
      <Button href="#planes" variant="secondary">Ver planes</Button>
    </div>
  </div>
</section>


<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(92svh, var(--hero-max-height));
    isolation: isolate;
    overflow: hidden;
  }

  /* Foto + dos capas planas: oscura para legibilidad y vino en multiplicar, como en sus historias. */
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: grid;
    place-items: start end;
    padding: var(--space-4);
    padding-top: var(--space-24);
    background: var(--color-neutral-700);
  }
  .hero__media::before,
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .hero__media::before {
    background: var(--color-accent-deep);
    mix-blend-mode: multiply;
  }
  .hero__media::after {
    background: var(--color-overlay);
    /* Más oscuro abajo, donde va el texto: misma capa, recortada en diagonal. */
    clip-path: polygon(0 35%, 100% 15%, 100% 100%, 0 100%);
  }
  .hero :global(.hero__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
  }
  .hero__placeholder {
    display: contents;
  }
  .hero__media-label {
    position: relative;
    z-index: 1;
    color: var(--color-text-soft);
    font-size: var(--step--1);
    font-weight: var(--weight-semibold);
  }

  /* Franja roja diagonal que barre la pantalla una vez al cargar. */
  .hero__sweep {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-accent);
    clip-path: polygon(30% 0, 55% 0, 25% 100%, 0 100%);
    transform: translateX(-110%);
    pointer-events: none;
  }

  .hero__content {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-section) var(--space-20);
  }
  .hero__title {
    font-size: var(--step-7);
    max-width: 15ch;
  }
  .hero__word {
    display: inline-block;
    overflow: clip;
    overflow-clip-margin: 0.1em;
    vertical-align: top;
  }
  .hero__word > span {
    display: inline-block;
  }
  .hero__lead {
    font-size: var(--step-1);
    max-width: 38ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__media {
      animation: hero-zoom var(--duration-ambient) var(--ease-out) both;
    }
    .hero__sweep {
      animation: hero-sweep var(--duration-entrance) var(--ease-in-out) 120ms both;
    }
    .hero__word > span {
      animation: line-up var(--duration-entrance) var(--ease-out-strong) both;
      animation-delay: calc(var(--line, 0) * var(--stagger));
    }
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.06);
    }
  }
  @keyframes hero-sweep {
    from {
      transform: translateX(-110%);
    }
    to {
      transform: translateX(210%);
    }
  }
  @keyframes line-up {
    from {
      transform: translateY(105%);
    }
  }
</style>
