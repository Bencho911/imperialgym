---
interface Props {
  id: string;
  title: string;
  intro?: string;
}
const { id, title, intro } = Astro.props;
---

<header class="section-heading">
  <h2 id={id} class="texture-worn" data-reveal="stamp">{title}</h2>
  {intro && <p class="section-heading__intro">{intro}</p>}
</header>

<style>
  .section-heading {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-stack);
  }
  h2 {
    font-size: var(--step-6);
  }
  .section-heading__intro {
    font-size: var(--step-1);
    color: var(--color-text-soft);
  }
</style>
