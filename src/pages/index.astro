---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Benefits from '../components/Benefits.astro';
import Plans from '../components/Plans.astro';
import ClassTicker from '../components/ClassTicker.astro';
import Classes from '../components/Classes.astro';
import Trainers from '../components/Trainers.astro';
import Hours from '../components/Hours.astro';
import Locations from '../components/Locations.astro';
import Gallery from '../components/Gallery.astro';
import Merch from '../components/Merch.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
---

<BaseLayout
  title="Imperial Gym | Gimnasio en Armenia, Quindío"
  description="Gimnasio en Armenia, Quindío, con sede Centro y sede Sur. Pesas, máquinas y clases grupales de spinning, boxeo y rumbaterapia. Escríbenos por WhatsApp."
>
  <LocalBusinessSchema slot="head" />
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <Header />
  <main id="contenido">
    <Hero />
    <ClassTicker />
    <Benefits />
    <Plans />
    <Classes />
    <Trainers />
    <Hours />
    <Locations />
    <Gallery />
    <Merch />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
  <WhatsAppFab />
</BaseLayout>
